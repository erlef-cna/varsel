# MITRE CVE Services API — https://cveawg.mitre.org/api-docs/
# Use https://cveawg-test.mitre.org/api for staging, https://cveawg.mitre.org/api for prod.
# Optional in development: set all four to talk to the real API, or none to use
# the built-in mock (random CVE IDs, publish stamps dates locally). Partial
# configuration is refused at boot. Production requires all four.
MITRE_CVE_API_BASE_URL=
MITRE_CVE_API_ORG=
MITRE_CVE_API_USER=
MITRE_CVE_API_KEY=

# OAuth login providers. Each is optional: set all of a provider's variables to
# offer it on the sign-in page, or none to leave it out. Partial configuration
# is refused at boot. With no provider configured, development falls back to
# the mock login.

# GitHub OAuth app credentials (login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hex.pm OAuth client credentials (login). Hex.pm has no self-serve client
# registration, so developing against a local hexpm instance is the practical
# option — set HEX_BASE_URL to point at it. Defaults to https://hex.pm.
HEX_CLIENT_ID=
HEX_CLIENT_SECRET=
HEX_BASE_URL=

# Private key (JSON Web Key) that signs Varsel's requests to hex.pm, used to
# look up whom to email for a case invite. Generate a pair with
# `mix generate_hex_service_key --kid <name>` and add the public half to
# hex.pm's HEXPM_VARSEL_JWKS. Unset, the invite falls back to the address the
# public hex.pm profile shows. A local hexpm pins its own dev fixture key
# (test/fixtures/varsel_private.pem in its repository) under the kid
# varsel-dev; to talk to one, set:
# HEX_SIGNING_KEY={"crv":"P-256","d":"2jjObl1K0ZWiDxXdm5TXO2jDrnbNNuCeguEfO3SePkk","kid":"varsel-dev","kty":"EC","x":"E34oPnnGyf9799k058t0zBpEo6cMDYDaFmmEEt2ePLw","y":"ajZ6c2ekFLfW1H-YBYlJKcKXpnfyu88FF2_PoewQCCU"}
HEX_SIGNING_KEY=

# Production only — not required in development

# Base64-encoded 32-byte AES-256-GCM key for the Cloak vault (encrypts
# sensitive attributes at rest in Postgres via ash_cloak). Development uses a
# static key from config/dev.exs.
# Generate with: mix run --no-start -e 'IO.puts Base.encode64(:crypto.strong_rand_bytes(32))'
CLOAK_KEY=

# Database connection URL (e.g. ecto://USER:PASS@HOST/DATABASE)
DATABASE_URL=

# Phoenix secret key base — generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname for the application
PHX_HOST=example.com

# HTTP port (default: 4000)
PORT=4000

# Start the Phoenix server (set to "true" in releases)
PHX_SERVER=true

# Enable IPv6 for database connection
ECTO_IPV6=true

# Database connection pool size (default: 10)
POOL_SIZE=10

# DNS cluster query for distributed Erlang
DNS_CLUSTER_QUERY=

# Secrets for signing auth tokens and OAuth 2.1 access tokens — generate
# each with: mix phx.gen.secret
TOKEN_SIGNING_SECRET=
OAUTH2_SIGNING_SECRET=
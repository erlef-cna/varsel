{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabledManagers: ["nix"],
  nix: {
    enabled: true,
  },
  schedule: ["* * * * 1"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* * * * 1"],
  },
}

<.error_page context="Error" status={401}>
  <:title>
    <span class="block max-w-lg text-pretty [text-wrap:balance]">Please sign in to continue</span>
  </:title>
  <p class="text-base-content/70 leading-relaxed">
    This page is only available to signed-in members of the CNA team. Published CVE records are always public — no account needed.
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-4">
    <.link href={~p"/sign-in"} class="btn btn-primary">
      <.icon name="hero-arrow-right-end-on-rectangle" class="size-4" /> Sign in
    </.link>
    <.link href={~p"/"} class="link link-primary text-sm font-semibold">Back to home →</.link>
  </div>
</.error_page>

<.error_page context="Error" status={404}>
  <:title>
    <span class="block max-w-lg text-pretty [text-wrap:balance]">Page not found</span>
  </:title>
  <p class="text-base-content/70 leading-relaxed">
    There's nothing at this address. The link that brought you here may be out of date, or the address may be mistyped.
  </p>

  <p class="mt-8 mb-3 text-xs font-semibold uppercase tracking-wide text-base-content/50">
    Useful places
  </p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-4xl">
    <a
      href={~p"/"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-home" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">Home</span>
        <span class="block text-xs text-base-content/60">Overview and latest CVEs</span>
      </span>
    </a>
    <a
      href={~p"/cves"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-list-bullet" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">All CVEs</span>
        <span class="block text-xs text-base-content/60">Browse published records</span>
      </span>
    </a>
    <a
      href={~p"/common-weaknesses"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-chart-pie" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">Common Weaknesses</span>
        <span class="block text-xs text-base-content/60">CWE distribution</span>
      </span>
    </a>
    <a
      href={~p"/report"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-shield-exclamation" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">Report a Vulnerability</span>
        <span class="block text-xs text-base-content/60">Coordinated disclosure intake</span>
      </span>
    </a>
    <a
      href={~p"/contact"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-envelope" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">Contact</span>
        <span class="block text-xs text-base-content/60">Reach the CNA team</span>
      </span>
    </a>
    <a
      href={~p"/security-policy"}
      class="flex items-center gap-3 rounded-box border border-base-300 bg-base-200 hover:bg-base-300 transition-colors px-4 py-3"
    >
      <.icon name="hero-book-open" class="size-5 text-primary shrink-0" />
      <span>
        <span class="block text-sm font-medium">Security Policy</span>
        <span class="block text-xs text-base-content/60">Disclosure process</span>
      </span>
    </a>
  </div>
</.error_page>

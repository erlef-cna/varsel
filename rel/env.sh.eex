#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Erlang Ecosystem Foundation

# Sourced by every release command (start, eval, rpc, remote).

# Fly runs machines on a private IPv6 network (6PN) and sets FLY_PRIVATE_IP to
# the machine's address there. Distribution is only configured when that is
# present, so local `bin/varsel` runs and CI keep the default short-name,
# non-distributed boot.
if [ -n "${FLY_PRIVATE_IP:-}" ]; then
  # Erlang distribution has to speak IPv6 to reach peers over 6PN, and the
  # release commands that connect back to a running node (eval, rpc, remote)
  # need the same flags to complete their handshake.
  export ELIXIR_ERL_OPTIONS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${RELEASE_NAME}@${FLY_PRIVATE_IP}"
fi
